# Copy to .env.local and fill in when ready to activate analytics/marketing.
# Both are optional — the site works fully without them.
# NEXT_PUBLIC_GTM_ID loads unconditionally (Google Tag Manager manages its
# own consent internally); NEXT_PUBLIC_META_PIXEL_ID is still gated behind
# the cookie consent banner (see components/Analytics.tsx).

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Endpoint que recibe los leads del formulario de contacto (components/LeadForm.tsx).
# Server-only — NUNCA prefijar con NEXT_PUBLIC_, ya que contiene el destino
# donde se guardan datos personales (nombre, email, teléfono).
# Hoy apunta a un Google Apps Script que escribe en una hoja de cálculo y
# avisa por correo a info@akka.es; más adelante se puede apuntar al CRM
# propio sin tocar código (ver app/api/leads/route.ts).
LEADS_WEBHOOK_URL=
# Opcional: token que el webhook exige en el header Authorization: Bearer <token>.
LEADS_WEBHOOK_TOKEN=
